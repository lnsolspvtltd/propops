# PropOps Environment Configuration

# AI
ANTHROPIC_API_KEY=
# ^ Generate your API key at https://console.anthropic.com/
# Example: sk-ant-v7-xxxxxxxxxxxxxxxxxxxxx

# Database
DATABASE_URL=
# ^ Connection string: postgresql+asyncpg://user:password@localhost:5432/propops
# DO NOT use default credentials in production
# Local dev example (NEVER commit with real password):
#   postgresql+asyncpg://propops:changeme@localhost:5432/propops

# Email Ingestion (IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
# ^ For Gmail: generate App Password at https://myaccount.google.com/apppasswords
IMAP_POLL_INTERVAL_SECONDS=60

# Email Outbound (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# ^ For Gmail: generate App Password at https://myaccount.google.com/apppasswords

# Supabase (if using cloud PostgreSQL)
SUPABASE_URL=
# ^ Example: https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
# ^ Public key for client-side operations (if applicable)
SUPABASE_SERVICE_KEY=
# ^ Server-side key — NEVER expose to frontend
# Note: these vars may be deprecated; confirm with team before removal

# Twilio SMS (optional, leave blank if not using)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=
# ^ Generate with: openssl rand -hex 32
# NEVER commit real value; always regenerate in production
CORS_ORIGINS=http://localhost:3000
# ^ Comma-separated list; NEVER use "*" in production

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
---
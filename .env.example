# PropOps Environment Configuration
# LN Sols Pvt Ltd – Incident Response & Property Management Platform
#
# CRITICAL SECURITY:
# WARNING: NEVER commit .env to version control. This file contains secrets.
#    Always:
#    1. Copy .env.example to .env locally
#    2. Add .env to .gitignore (already configured)
#    3. Set real secrets in CI/CD or deployment platform
#    4. Rotate secrets regularly in production
#
# This file (.env.example) contains ONLY example/placeholder values.
# All real secrets are set via deployment platform (Railway, Heroku, etc).
# No real API keys, passwords, or credentials are committed here.

# Core Configuration
# ──────────────────────────────────────────────────────────────────

# Environment: development, staging, or production
# Default: development (change to staging or production in deployment)
ENVIRONMENT=development

# Enable verbose error pages and logs (must be false in production for security)
# Default: false
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO (use DEBUG for local development, ERROR for production)
LOG_LEVEL=INFO

# Database Configuration
# ──────────────────────────────────────────────────────────────────

# PostgreSQL async connection string (must use asyncpg driver for FastAPI)
# Format: postgresql+asyncpg://user:password@host:port/database
#
# CRITICAL WARNING: Use environment-specific credentials, never hardcode production values.
# This example uses placeholders — replace USER, PASSWORD, HOST, PORT, DB with real values.
#
# Development examples:
#   postgresql+asyncpg://propops_dev_user:devpass123@localhost:5432/propops_dev
#   postgresql+asyncpg://postgres:postgres@localhost:5432/propops_dev (if using default pg user)
#
# Staging/Production:
#   Set DATABASE_URL in your deployment platform (Railway, Heroku, AWS RDS, Supabase, etc.)
#   NEVER commit production credentials to .env or .git
#   NEVER use development passwords in staging/production
#   Example format only (NEVER real values):
#   postgresql+asyncpg://produser:prodpass@prod.db.example.com:5432/proddb
#
# REQUIRED: Must be set explicitly before application startup.
# No production default is provided — application will fail fast with clear error if absent.
# For tests, see pytest fixtures that set this to in-memory SQLite or test Postgres.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB

# Connection pool tuning (adjust based on concurrency needs and database capacity)
#
# Development (local dev machine, single worker):
#   DATABASE_POOL_SIZE=5
#   DATABASE_MAX_OVERFLOW=10
#   Supports ~5 concurrent connections + 10 burst
#
# Staging (moderate load, 2–4 workers):
#   DATABASE_POOL_SIZE=10
#   DATABASE_MAX_OVERFLOW=20
#   Supports ~10 concurrent connections + 20 burst per worker
#
# Production (high load, 4+ workers, managed database):
#   DATABASE_POOL_SIZE=20
#   DATABASE_MAX_OVERFLOW=40
#   Supports ~20 concurrent connections + 40 burst per worker
#   Scale based on database max_connections and worker processes.
#
# Default values (if not set): DATABASE_POOL_SIZE=10, DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Recycle connections after this many seconds (prevents RDS timeout issues)
# Default: 3600 (1 hour). AWS RDS default idle timeout: 900s (15 min).
# Set to 800 if using AWS RDS to stay under idle timeout.
DATABASE_POOL_RECYCLE=3600

# Pre-ping connections before use to detect stale connections
# Default: true (recommended to avoid 'connection closed' errors)
DATABASE_POOL_PRE_PING=true

# API Keys & Secrets
# ──────────────────────────────────────────────────────────────────

# Anthropic API Key for Claude LLM access
# Get from: https://console.anthropic.com/account/keys
# NEVER commit real keys to .env or version control
# In production, set via deployment platform environment variables
# Leave empty in development if not using LLM features
ANTHROPIC_API_KEY=

# API Configuration
# ──────────────────────────────────────────────────────────────────

# API title for OpenAPI documentation
API_TITLE=PropOps API

# API version for OpenAPI documentation
API_VERSION=0.1.0-alpha

# Root path prefix for all API routes
# Examples: "" (no prefix), "/api" (mounts at /api/...), "/api/v1" (versioned)
API_ROOT_PATH=

# CORS Configuration
# ──────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins
# Development: localhost origins for frontend dev server
# Production: explicit domain list only (NEVER use wildcard *)
# 
# Examples:
#   Development: http://localhost:3000,http://localhost:5173
#   Staging:     https://staging.propops.example.com,https://admin.staging.example.com
#   Production:  https://propops.example.com,https://admin.propops.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Allow credentials (Authorization header, cookies) in CORS requests
# Default: true (required for JWT auth)
CORS_ALLOW_CREDENTIALS=true

# Comma-separated list of allowed HTTP methods
# Default: GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Comma-separated list of allowed headers
# Default: * (allow all headers). Can specify explicit list: Content-Type,Authorization
CORS_ALLOW_HEADERS=*

# Rate Limiting (optional, for future use)
# ──────────────────────────────────────────────────────────────────

# Enable rate limiting on API endpoints
# Default: false (disabled)
RATE_LIMIT_ENABLED=false

# Requests per minute per IP address (if rate limiting enabled)
# Default: 60
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Monitoring & Error Tracking
# ──────────────────────────────────────────────────────────────────

# Sentry error tracking DSN
# Get from: https://sentry.io/settings/organizations/[ORG]/projects/[PROJECT]/keys/
# Optional; leave empty to disable error tracking
# In production, set via deployment platform to enable monitoring
SENTRY_DSN=
---
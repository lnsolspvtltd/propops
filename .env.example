# ═════════════════════════════════════════════════════════════════════════════
# PropOps Environment Configuration
# LN Sols Pvt Ltd — Incident Response & Property Management Platform
# ═════════════════════════════════════════════════════════════════════════════
#
# CRITICAL SECURITY: 
# ⚠️  NEVER commit .env to version control. This file contains secrets.
#    Always:
#    1. Copy .env.example to .env locally
#    2. Add .env to .gitignore (already configured)
#    3. Set real secrets in CI/CD or deployment platform
#    4. Rotate secrets regularly in production
#
# ═════════════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────────────
# Environment: development, staging, or production
ENVIRONMENT=development

# Enable verbose error pages and logs (NEVER in production)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL async connection string (must use asyncpg driver for FastAPI)
# Format: postgresql+asyncpg://user:password@host:port/database
# ⚠️  CRITICAL: Use environment-specific credentials, never hardcode production values
DATABASE_URL=

# Connection pool tuning (adjust based on concurrency needs)
# Development:  pool_size=5,  max_overflow=10
# Production:   pool_size=20, max_overflow=40 (scale per CPU cores and workers)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ── API ───────────────────────────────────────────────────────────────────
# Server bind address (0.0.0.0 = listen on all interfaces)
API_HOST=0.0.0.0

# Server port (1024–65535; use 8000 for dev, 8080 for containers)
API_PORT=8000

# ── Security ──────────────────────────────────────────────────────────────
# CRITICAL SECRETS — Change all defaults immediately in non-development environments
# Do not use any "dev-" or "test-" secrets in production

# Application secret key (used for signed tokens, session encryption)
# Generate with: openssl rand -hex 32
# ⚠️  CRITICAL: Must be at least 32 characters in production
SECRET_KEY=

# JWT signing secret (separate from general SECRET_KEY for defense-in-depth)
# Generate with: openssl rand -hex 32
# Used to sign and verify JWT access/refresh tokens
JWT_SECRET=

# JWT token expiry times (seconds)
JWT_ACCESS_TOKEN_EXPIRY=900        # 15 minutes
JWT_REFRESH_TOKEN_EXPIRY=604800    # 7 days

# Allowed CORS origins (comma-separated; no spaces)
# Development: http://localhost:3000,http://localhost:8000
# Production: https://app.propops.com,https://dashboard.propops.com (explicit list only)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Integrations ──────────────────────────────────────────────────────────
# Anthropic Claude API key (optional — required only if AI features enabled)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# ── Email (Optional — Legacy Ingestion) ────────────────────────────────────
# DEPRECATION NOTE: Email ingestion config moved to separate service config.
# If using legacy email integration, define here; otherwise leave empty.
# Support: See docs/integrations/email-setup.md
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
GMAIL_SERVICE_ACCOUNT_JSON=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# ═════════════════════════════════════════════════════════════════════════════
# DO NOT EDIT BELOW THIS LINE — Advanced / Reserved
# ═════════════════════════════════════════════════════════════════════════════

# Database SSL mode (require, prefer, disable) — use 'require' in production
DATABASE_SSL_MODE=disable

# Sentry error tracking (optional)
SENTRY_DSN=

# Environment-specific identifier for logging/debugging
DEPLOYMENT_ID=dev-local
---
# PropOps — LN Sols Pvt Ltd
# Copy to .env and fill in values. NEVER commit .env

# ── AI ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=           # Claude Haiku + Sonnet

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/propops
SUPABASE_URL=                # https://xxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Email Ingestion ────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=               # inbox@yourproperty.com
IMAP_PASSWORD=               # Gmail app password
IMAP_POLL_INTERVAL_SECONDS=60

# Gmail API (alternative to IMAP)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Outlook API (alternative)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=

# ── SMTP (outbound) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Twilio (SMS) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── App ────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=                  # 32-char random string for JWT
CORS_ORIGINS=http://localhost:3000

# ── Frontend ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PropOps
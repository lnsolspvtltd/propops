# PropOps Environment Configuration
# LN Sols Pvt Ltd – Incident Response & Property Management Platform
#
# CRITICAL SECURITY:
# WARNING: NEVER commit .env to version control. This file contains secrets.
#    Always:
#    1. Copy .env.example to .env locally
#    2. Add .env to .gitignore (already configured)
#    3. Set real secrets in CI/CD or deployment platform
#    4. Rotate secrets regularly in production
#
# This file (.env.example) contains ONLY example/placeholder values.
# All real secrets are set via deployment platform (Railway, Heroku, etc).
# No real API keys, passwords, or credentials are committed here.

# Core Configuration
# ──────────────────────────────────────────────────────────────────

# Environment: development, staging, or production
# Default: development (change to staging or production in deployment)
ENVIRONMENT=development

# Enable verbose error pages and logs (NEVER in production)
# Default: false (must be false in production for security)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO (use DEBUG for local development, ERROR for production)
LOG_LEVEL=INFO

# Database Configuration
# ──────────────────────────────────────────────────────────────────

# PostgreSQL async connection string (must use asyncpg driver for FastAPI)
# Format: postgresql+asyncpg://user:password@host:port/database
#
# CRITICAL WARNING: Use environment-specific credentials, never hardcode production values.
# This example uses placeholders — replace USER, PASSWORD, HOST, PORT, DB with real values.
#
# Development examples:
#   postgresql+asyncpg://propops_dev_user:devpass123@localhost:5432/propops_dev
#   postgresql+asyncpg://postgres:postgres@localhost:5432/propops_dev (if using default pg user)
#
# Staging/Production:
#   Set DATABASE_URL in your deployment platform (Railway, Heroku, AWS RDS, Supabase, etc.)
#   NEVER commit production credentials to .env or .git
#   NEVER use development passwords in staging/production
#   Example format only (NEVER real values):
#   postgresql+asyncpg://produser:prodpass@prod.db.example.com:5432/proddb
#
# REQUIRED: Must be set explicitly before application startup.
# No production default is provided — application will fail fast with clear error if absent.
# For tests, see pytest fixtures that set this to in-memory SQLite or test Postgres.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB

# Connection pool tuning (adjust based on concurrency needs and database capacity)
#
# Development (local dev machine, single worker):
#   DATABASE_POOL_SIZE=5
#   DATABASE_MAX_OVERFLOW=10
#   Supports ~5 concurrent connections + 10 burst
#
# Staging (moderate load, 2–4 workers):
#   DATABASE_POOL_SIZE=10
#   DATABASE_MAX_OVERFLOW=20
#   Supports ~10 concurrent connections + 20 burst per worker
#
# Production (high load, 4+ workers, managed database):
#   DATABASE_POOL_SIZE=20
#   DATABASE_MAX_OVERFLOW=40
#   Supports ~20 concurrent connections + 40 burst per worker
#   Scale based on: (available_db_connections / num_app_workers)
#
# REQUIRED: Must be set; no default provided.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Database Echo (log all SQL statements)
# Development: true (useful for debugging queries)
# Production: false (verbose logging impacts performance and security)
# Default: false
DATABASE_ECHO=false

# API Configuration
# ──────────────────────────────────────────────────────────────────

# API host and port (for local development)
# Format: 0.0.0.0 for all interfaces, 127.0.0.1 for localhost only
# Default: 0.0.0.0 (accessible from any interface)
API_HOST=0.0.0.0

# API port (local development only; production uses Railway/Docker EXPOSE)
# Default: 8000
API_PORT=8000

# API URL for external references (webhooks, email links, etc.)
# Development: http://localhost:8000
# Staging: https://staging-api.propops.app
# Production: https://api.propops.app
# REQUIRED: Must match the actual deployment URL for webhooks and email links to work
API_URL=http://localhost:8000

# Anthropic Claude API Configuration
# ──────────────────────────────────────────────────────────────────

# Anthropic API key (for Claude LLM integration)
# Get key from: https://console.anthropic.com/account/keys
# SECURITY-REVIEW: In production, set via Railway environment variables or CI/CD secrets.
# NEVER commit this to .git. Rotate regularly.
# REQUIRED: Must be set explicitly; weak defaults (dev-) are rejected in production.
ANTHROPIC_API_KEY=dev-placeholder-key-do-not-use-in-production

# Default Claude model for incident analysis and summary generation
# Options: claude-opus-4-1, claude-sonnet-4, claude-haiku-4-5
# Default: claude-haiku-4-5 (fast, low cost; good for classification)
# For complex analysis, use claude-sonnet-4 or claude-opus-4-1
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5

# Incident Analysis Configuration
# ──────────────────────────────────────────────────────────────────

# Maximum characters of incident description to send to Claude
# Longer incidents are truncated to avoid token limits
# Default: 3000 characters
INCIDENT_MAX_CHARS_FOR_LLM=3000

# Incident auto-resolution timeout (hours)
# After this many hours of no activity, open incidents are auto-resolved
# Set to 0 to disable auto-resolution
# Default: 72 hours (3 days)
INCIDENT_AUTO_RESOLVE_HOURS=72

# Email Configuration (for notifications and escalations)
# ──────────────────────────────────────────────────────────────────

# Email provider: smtp or sendgrid
# Default: smtp (standard SMTP relay)
EMAIL_PROVIDER=smtp

# SMTP server host (if EMAIL_PROVIDER=smtp)
# Example: smtp.gmail.com, smtp.sendgrid.net, mail.propops.app
SMTP_HOST=localhost

# SMTP server port (if EMAIL_PROVIDER=smtp)
# Standard ports: 25 (unencrypted), 587 (TLS), 465 (SSL)
# Default: 587 (TLS recommended)
SMTP_PORT=587

# SMTP username (if EMAIL_PROVIDER=smtp)
# Leave blank for open relay or anonymous SMTP
SMTP_USERNAME=

# SMTP password (if EMAIL_PROVIDER=smtp)
# SECURITY-REVIEW: Use app-specific password, not personal account password.
# Set via deployment platform secrets in production, never in .git.
SMTP_PASSWORD=

# SendGrid API key (if EMAIL_PROVIDER=sendgrid)
# Get key from: https://app.sendgrid.com/settings/api_keys
# SECURITY-REVIEW: Never commit to .git; set via deployment platform secrets.
SENDGRID_API_KEY=

# From email address for all outgoing notifications
# Must be a valid email in your domain
NOTIFICATION_FROM_EMAIL=noreply@propops.app

# Slack Integration (optional, for incident notifications)
# ──────────────────────────────────────────────────────────────────

# Slack webhook URL for incident notifications
# Get from: Slack workspace → Settings → Integrations → Incoming Webhooks
# Leave blank to disable Slack notifications
# SECURITY-REVIEW: Webhook URLs are secrets; set via deployment platform, never in .git.
SLACK_WEBHOOK_URL=

# Slack channel for incident alerts (e.g., #incidents, #ops-alerts)
# Leave blank to use webhook's configured channel
SLACK_CHANNEL=

# Testing & Development
# ──────────────────────────────────────────────────────────────────

# Test mode flag (enables test fixtures and mock data)
# NEVER true in production
# Default: false
TESTING=false

# Database for tests (if TESTING=true)
# Example: postgresql+asyncpg://test_user:testpass@localhost:5432/test_db
# Leave blank to use in-memory SQLite for tests
# Optional: useful for integration tests with real Postgres
TEST_DATABASE_URL=

# Secret Configuration
# ──────────────────────────────────────────────────────────────────

# JWT secret key for signing authentication tokens
# Generate secure random key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECURITY-REVIEW: 
#   - Development: can use placeholder (checked for 'dev-' prefix)
#   - Staging: must be strong random secret, rotated every 3 months
#   - Production: must be strong random secret, rotated every 3 months, stored in secrets manager
# REQUIRED: Must be set explicitly; weak defaults are rejected in production.
JWT_SECRET_KEY=dev-change-me-in-production-with-random-32-char-string

# JWT token expiry (seconds)
# Default: 900 (15 minutes) for access tokens
JWT_EXPIRY_SECONDS=900

# Refresh token expiry (days)
# Default: 7 (7 days)
REFRESH_TOKEN_EXPIRY_DAYS=7

# Observability & Monitoring
# ──────────────────────────────────────────────────────────────────

# Enable Sentry error tracking
# Leave blank to disable Sentry
# Get DSN from: https://sentry.io/projects/
SENTRY_DSN=

# Enable DataDog APM (application performance monitoring)
# Set to true to enable, false to disable
# Requires DataDog agent running in container
DATADOG_ENABLED=false

# Development & Debugging Flags
# ──────────────────────────────────────────────────────────────────

# Verbose request/response logging (development only)
# Logs all HTTP requests and responses (can be noisy)
# NEVER true in production — security risk and performance impact
# Default: false
VERBOSE_HTTP_LOGGING=false

# Reload on file change (development only, for uvicorn --reload)
# FastAPI development server automatically restarts on code changes
# NEVER true in production
# Default: false
RELOAD_ON_CHANGE=false

# Profile code execution (development only)
# Enables cProfile output for performance debugging
# NEVER true in production
# Default: false
PROFILING_ENABLED=false

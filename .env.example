# ═══════════════════════════════════════════════════════════════════
# PropOps Local Development Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# DO NOT commit .env to git — use .env.example for documentation

# ──── Database ──────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=propops
# DATABASE_URL is constructed in docker-compose from above values
# For local dev without Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/propops

# ──── Anthropic API (Claude Haiku + Sonnet) ────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ──── Email Ingestion (IMAP) ────────────────────────────────────────
# Gmail: enable "App Passwords" in Google Account settings
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_POLL_INTERVAL_SECONDS=60

# ──── Email Outbound (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ──── Twilio SMS (optional) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ──── Application ───────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]

# ──── Frontend ──────────────────────────────────────────────────────
# Backend API URL from frontend (inside Docker, use container hostname)
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development
---
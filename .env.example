# PropOps Environment Configuration
# LN Sols Pvt Ltd – Incident Response & Property Management Platform
#
# CRITICAL SECURITY:
# WARNING: NEVER commit .env to version control. This file contains secrets.
#    Always:
#    1. Copy .env.example to .env locally
#    2. Add .env to .gitignore (already configured)
#    3. Set real secrets in CI/CD or deployment platform
#    4. Rotate secrets regularly in production
#
# This file (.env.example) contains ONLY example/placeholder values.
# All real secrets are set via deployment platform (Railway, Heroku, etc).
# No real API keys, passwords, or credentials are committed here.

# Core Configuration
# ──────────────────────────────────────────────────────────────────

# Environment: development, staging, or production
# Default: development (change to staging or production in deployment)
ENVIRONMENT=development

# Enable verbose error pages and logs (NEVER in production)
# Default: false (must be false in production for security)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO (use DEBUG for local development, ERROR for production)
LOG_LEVEL=INFO

# Database Configuration
# ──────────────────────────────────────────────────────────────────

# PostgreSQL async connection string (must use asyncpg driver for FastAPI)
# Format: postgresql+asyncpg://user:password@host:port/database
#
# CRITICAL WARNING: Use environment-specific credentials, never hardcode production values.
# This example uses placeholders — replace USER, PASSWORD, HOST, PORT, DB with real values.
#
# Development examples:
#   postgresql+asyncpg://propops_dev_user:devpass123@localhost:5432/propops_dev
#   postgresql+asyncpg://postgres:postgres@localhost:5432/propops_dev (if using default pg user)
#
# Staging/Production:
#   Set DATABASE_URL in your deployment platform (Railway, Heroku, AWS RDS, Supabase, etc.)
#   NEVER commit production credentials to .env or .git
#   NEVER use development passwords in staging/production
#   Example format only (NEVER real values):
#   postgresql+asyncpg://produser:prodpass@prod.db.example.com:5432/proddb
#
# REQUIRED: Must be set explicitly before application startup.
# No production default is provided — application will fail fast with clear error if absent.
# For tests, see pytest fixtures that set this to in-memory SQLite or test Postgres.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB

# Connection pool tuning (adjust based on concurrency needs and database capacity)
#
# Development (local dev machine, single worker):
#   DATABASE_POOL_SIZE=5
#   DATABASE_MAX_OVERFLOW=10
#   Supports ~5 concurrent connections + 10 burst
#
# Staging (moderate load, 2–4 workers):
#   DATABASE_POOL_SIZE=10
#   DATABASE_MAX_OVERFLOW=20
#   Supports ~10 concurrent connections + 20 burst per worker
#
# Production (high load, 4+ workers, managed database):
#   DATABASE_POOL_SIZE=20
#   DATABASE_MAX_OVERFLOW=40
#   Supports ~20 concurrent connections + 40 burst per worker
#   Scale based on: (CPU cores × workers) + buffer for background tasks
#
# NOTE: Pool size must not exceed database max_connections / num_workers
#       Typical PostgreSQL: max_connections=100
#       With 4 workers: max 20 per worker = 4 × 20 = 80 connections
#
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# PostgreSQL SSL mode: require, prefer, or disable
# Development: disable (local connections are unencrypted)
# Staging/Production: require (must use TLS; fail if unavailable)
#
DATABASE_SSL_MODE=disable

# API Configuration
# ──────────────────────────────────────────────────────────────────

# Server bind address (0.0.0.0 = listen on all interfaces)
API_HOST=0.0.0.0

# Server port
API_PORT=8000

# Security Configuration
# ──────────────────────────────────────────────────────────────────

# Application secret key (change in production)
# SECURITY-REVIEW: In production, must be 32+ random characters, NOT starting with 'dev-'
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Development default is weak and only for local testing
SECRET_KEY=dev-secret-key-local-testing-only

# JWT signing secret (separate from SECRET_KEY)
# SECURITY-REVIEW: In production, must be 32+ random characters, NOT starting with 'dev-'
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Development default is weak and only for local testing
JWT_SECRET=dev-jwt-secret-local-testing-only

# Access token TTL in seconds (default: 15 minutes = 900 seconds)
# Shorter expiry (5–15 min) is more secure; requires refresh token for extended sessions
JWT_ACCESS_TOKEN_EXPIRY=900

# Refresh token TTL in seconds (default: 7 days = 604800 seconds)
# Longer expiry (7–30 days) allows users to stay logged in without frequent re-auth
# Stored in httpOnly cookie; never exposed to JavaScript
JWT_REFRESH_TOKEN_EXPIRY=604800

# Allowed CORS origins (comma-separated or JSON array)
# Development: http://localhost:3000, http://localhost:3001
# Production: ONLY explicit origins, NEVER wildcard '*'
# Examples:
#   ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
#   ALLOWED_ORIGINS=["https://example.com","https://app.example.com"]
ALLOWED_ORIGINS=["http://localhost:3000"]

# Supabase Configuration (if using Supabase)
# ──────────────────────────────────────────────────────────────────

# Supabase service_role API key (server-side only, never expose to client)
# Get from: Supabase dashboard > Settings > API > service_role secret
# SECURITY-REVIEW: This key has unrestricted database access. Rotate regularly.
# Enforce least-privilege scopes; consider using Supabase RLS instead of service key.
# NEVER commit real service keys to .env or .git
# REQUIRED only if using Supabase; optional otherwise
SUPABASE_SERVICE_KEY=

# AI / LLM Configuration
# ──────────────────────────────────────────────────────────────────

# Anthropic API key for Claude models (optional, only if using AI features)
# Get from: https://console.anthropic.com/account/api-keys
# NEVER commit real API keys to .env or .git
# Optional — only set if using LLM-powered features
ANTHROPIC_API_KEY=
---
# ═══════════════════════════════════════════════════════════════════════════════
# PropOps Environment Configuration
# LN Sols Pvt Ltd – Incident Response & Property Management Platform
# ═══════════════════════════════════════════════════════════════════════════════
#
# CRITICAL SECURITY:
# WARNING: NEVER commit .env to version control. This file contains secrets.
#    Always:
#    1. Copy .env.example to .env locally
#    2. Add .env to .gitignore (already configured)
#    3. Set real secrets in CI/CD or deployment platform
#    4. Rotate secrets regularly in production
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Core Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Environment: development, staging, or production
ENVIRONMENT=development

# Enable verbose error pages and logs (NEVER in production)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL async connection string (must use asyncpg driver for FastAPI)
# Format: postgresql+asyncpg://user:password@host:port/database
#
# CRITICAL WARNING: Use environment-specific credentials, never hardcode production values.
# This example uses placeholders — replace USER, PASSWORD, HOST, PORT, DB with real values.
#
# Development examples:
#   postgresql+asyncpg://propops_dev_user:devpass123@localhost:5432/propops_dev
#   postgresql+asyncpg://postgres:postgres@localhost:5432/propops_dev (if using default pg user)
#
# Staging/Production:
#   Set DATABASE_URL in your deployment platform (Railway, Heroku, AWS RDS, Supabase, etc.)
#   NEVER commit production credentials to .env or .git
#   NEVER use development passwords in staging/production
#
# REQUIRED: Must be set explicitly before application startup.
# No production default is provided — application will fail fast with clear error if absent.
# For tests, see pytest fixtures that set this to in-memory SQLite or test Postgres.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB

# Connection pool tuning (adjust based on concurrency needs and database capacity)
#
# Development (local dev machine, single worker):
#   DATABASE_POOL_SIZE=5
#   DATABASE_MAX_OVERFLOW=10
#   Supports ~5 concurrent connections + 10 burst
#
# Staging (moderate load, 2–4 workers):
#   DATABASE_POOL_SIZE=10
#   DATABASE_MAX_OVERFLOW=20
#   Supports ~10 concurrent connections + 20 burst per worker
#
# Production (high load, 4+ workers, managed database):
#   DATABASE_POOL_SIZE=20
#   DATABASE_MAX_OVERFLOW=40
#   Supports ~20 concurrent connections + 40 burst per worker
#   Scale based on: (CPU cores × workers) + buffer for background tasks
#
# NOTE: Pool size must not exceed database max_connections / num_workers
#       Typical PostgreSQL: max_connections=100
#       With 4 workers: max 20 per worker = 4 × 20 = 80 < 100 ✓
#
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Database SSL mode (require, prefer, disable)
# ─ disable: No SSL (local development only)
# ─ prefer:  Try SSL, fallback to plaintext (transitional staging)
# ─ require: SSL mandatory (staging/production required for security)
DATABASE_SSL_MODE=disable

# ─────────────────────────────────────────────────────────────────────────────
# API Server Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Server bind address (0.0.0.0 = listen on all interfaces)
API_HOST=0.0.0.0

# Server port (1024–65535; use 8000 for dev, 8080 for containers)
API_PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# Security Configuration
# ─────────────────────────────────────────────────────────────────────────────

# CRITICAL SECRETS – Change all defaults immediately in non-development environments
# Do not use any "dev-" or "test-" secrets in production.
# In staging/production, these MUST be set to strong random values via deployment platform.
# Weak secrets in production will be rejected at startup with ValidationError.

# Application secret key (used for signed tokens, session encryption, etc.)
# ─ Generate with: openssl rand -hex 32
# ─ Length: minimum 8 characters (production: minimum 32)
# ─ Pattern: Must not start with 'dev-' in production
#
# Development default (CHANGE IN STAGING/PRODUCTION):
#   dev-secret-key-local-testing-only
#
# Staging/Production:
#   Generate secure random key: openssl rand -hex 32
#   Set in deployment platform (Railway dashboard, Heroku config vars, etc.)
#   NEVER commit to .git
#   NEVER use same value as JWT_SECRET
#
SECRET_KEY=dev-secret-key-local-testing-only

# JWT signing secret (separate from general SECRET_KEY for defense-in-depth)
# ─ Generate with: openssl rand -hex 32
# ─ Used to sign and verify JWT access/refresh tokens
# ─ Length: minimum 8 characters (production: minimum 32)
# ─ Pattern: Must not start with 'dev-' in production
#
# Development default (CHANGE IN STAGING/PRODUCTION):
#   dev-jwt-secret-local-testing-only
#
# Staging/Production:
#   Generate secure random key: openssl rand -hex 32
#   Set in deployment platform (Railway dashboard, Heroku config vars, etc.)
#   NEVER commit to .git
#   NEVER use same value as SECRET_KEY
#
JWT_SECRET=dev-jwt-secret-local-testing-only

# JWT token expiry times (seconds)
# ─ ACCESS: How long before access token expires (default: 900s = 15 minutes)
#   Production recommendation: 15-30 minutes
# ─ REFRESH: How long before refresh token expires (default: 604800s = 7 days)
#   Production recommendation: 7-30 days (user signs in again if expired)
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# Allowed CORS origins (comma-separated; no spaces after commas)
# ─ Development: http://localhost:3000,http://localhost:8000,http://localhost:5173
# ─ Staging: https://app-staging.propops.com,https://dashboard-staging.propops.com
# ─ Production: https://app.propops.com,https://dashboard.propops.com (explicit list only)
#
# CRITICAL WARNING: Never use wildcard (*) in production
#   Wildcard = any website can make requests on behalf of your users (CSRF attacks)
#   Must be explicit origin list: https://app.example.com,https://dashboard.example.com
#
# Format: protocol://hostname:port (include port if not 80/443)
# Multiple: comma-separated, no spaces
#
ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Integrations
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic Claude API key (optional — only required if AI features are enabled)
# ─ Get API key at: https://console.anthropic.com/account/keys
# ─ Format: sk-ant-... (approximately 20 characters)
# ─ Required for: Incident triage, auto-response suggestions, policy analysis
# ─ If not set: AI features are gracefully disabled (non-critical)
# ─ Production: Set in deployment platform, never in .git
#
# Development/Testing: Can be left empty (non-critical feature)
# Staging/Production: Set if AI features are enabled in that environment
#
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Logging & Observability (future use)
# ─────────────────────────────────────────────────────────────────────────────

# Placeholder for future logging integrations (Sentry, DataDog, etc.)
# Currently configured via LOG_LEVEL above
---
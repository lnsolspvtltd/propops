# PropOps Environment Configuration
# Copy to .env and fill in your values

# ── Core ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL async connection string (must use asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/propops

# Connection pool tuning
# For development: pool_size=5, max_overflow=10
# For production: pool_size=20, max_overflow=40 (scale based on workers)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ── API ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Security ──────────────────────────────────────────────────────────────
# CRITICAL: Change in production!
SECRET_KEY=dev-secret-key-change-in-production

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Integrations ──────────────────────────────────────────────────────────
# Anthropic API key (optional — required for AI features)
ANTHROPIC_API_KEY=
---
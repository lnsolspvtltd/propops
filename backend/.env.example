# ───────────────────────────────────────────────────────────────
# PropOps Backend Configuration
# ───────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and should NEVER be committed.
# ───────────────────────────────────────────────────────────────

# ENVIRONMENT
# Options: development, staging, production
# - development: Relaxed validation, verbose logging
# - staging: Production-like but with relaxed secret enforcement
# - production: Strict validation, minimum secret length 32 chars
ENVIRONMENT=development
LOG_LEVEL=INFO

# DATABASE
# PostgreSQL async driver connection string.
# Required in production.
# Format: postgresql+asyncpg://user:password@host:port/database
# Example (local): postgresql+asyncpg://postgres:postgres@localhost:5432/propops
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/propops

# IMAP INBOX INGESTION (Gmail IMAP with App Password)
# ⚠️  PRODUCTION: Use AWS Secrets Manager or HashiCorp Vault instead of environment variables
# See: https://docs.aws.amazon.com/secretsmanager/latest/userguide/
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
# Generate App Password (NOT your Gmail password): https://myaccount.google.com/apppasswords
# This is a 16-character alphanumeric string with spaces
IMAP_PASSWORD=your-16-char-app-password
# Polling interval in seconds. Recommended: 60 (production), 10 (development)
IMAP_POLL_INTERVAL_SECONDS=60

# SMTP OUTBOUND
# ⚠️  PRODUCTION: Use AWS Secrets Manager or HashiCorp Vault instead of environment variables
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
# Generate App Password (NOT your Gmail password): https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-16-char-app-password

# ANTHROPIC AI
# ⚠️  PRODUCTION: Use AWS Secrets Manager or HashiCorp Vault instead of environment variables
# Get your API key from: https://console.anthropic.com/account/api-keys
# Example: sk-ant-v0-abc123xyz...
ANTHROPIC_API_KEY=your-anthropic-api-key

# TWILIO SMS (Phase 2)
# ⚠️  PRODUCTION: Use AWS Secrets Manager or HashiCorp Vault instead of environment variables
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# SECURITY — SECRET_KEY
# ⚠️  CRITICAL: Generate a cryptographically secure key for production
# Generate with: openssl rand -hex 32
# Must be at least 32 characters in production.
# This value is validated by startup checks and will cause app to fail if:
#   - Less than 32 characters in production
#   - Still a placeholder value (contains "change-me", "dev-secret", etc.)
# NEVER use the default placeholder below in production.
# Example (DO NOT USE IN PRODUCTION): dev-secret-key-local-testing-only
SECRET_KEY=dev-secret-key-local-testing-only

# CORS & HTTP — CORS_ORIGINS
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS).
# Browser requests from origins NOT in this list will be blocked.
# Parser: values are split on comma and each is stripped of whitespace.
# Examples:
#   Development (single frontend): http://localhost:3000
#   Production (multiple): https://app.propops.io,https://www.propops.io,https://admin.propops.io
#   Staging: https://staging-app.propops.io
# For local development with frontend at http://localhost:3000:
CORS_ORIGINS=http://localhost:3000

# ORGANIZATION
# UUID of the default organization for email polling.
# In a single-org setup, fill this with your organization's UUID.
# In a multi-tenant setup, this should be overridden per request; the default
# is used only when no organization context is provided.
# You can find this by running: SELECT id FROM organizations LIMIT 1;
DEFAULT_ORG_ID=your-org-uuid-here
---
# ───────────────────────────────────────────────────────────────
# PropOps Backend Configuration
# ───────────────────────────────────────────────────────────────

# ENVIRONMENT
ENVIRONMENT=development
LOG_LEVEL=INFO

# DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/propops

# IMAP INBOX INGESTION (Gmail IMAP with App Password)
# ⚠️ PRODUCTION: Use AWS Secrets Manager or HashiCorp Vault instead of environment variables
# See: https://docs.aws.amazon.com/secretsmanager/latest/userguide/
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
# Generate App Password (not your Gmail password): https://myaccount.google.com/apppasswords
IMAP_PASSWORD=your-16-char-app-password

IMAP_POLL_INTERVAL_SECONDS=60

# SMTP OUTBOUND
# ⚠️ PRODUCTION: Use AWS Secrets Manager or HashiCorp Vault instead of environment variables
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
# Generate App Password (not your Gmail password): https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-16-char-app-password

# ANTHROPIC AI
# ⚠️ PRODUCTION: Use AWS Secrets Manager or HashiCorp Vault instead of environment variables
ANTHROPIC_API_KEY=your-anthropic-api-key

# TWILIO SMS (Phase 2)
# ⚠️ PRODUCTION: Use AWS Secrets Manager or HashiCorp Vault instead of environment variables
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# SECURITY
# ⚠️ CRITICAL: Generate a cryptographically secure key for production
# Generate with: openssl rand -hex 32
# Must be at least 32 characters (64 hex digits).
# NEVER use the default placeholder below in production.
# This value is checked by CI/CD and will fail if not changed before deploy.
SECRET_KEY=change-me-to-secure-random-value-with-openssl-rand-hex-32

# CORS & HTTP
# Comma-separated list of allowed origins for CORS requests
# Examples:
#   - Development: http://localhost:3000
#   - Production: https://app.propops.io,https://www.propops.io
# Parser: values are split on comma and stripped of whitespace
CORS_ORIGINS=http://localhost:3000

# ORGANIZATION
# UUID of default organization for email polling
# In multi-tenant setup, this should be per-org; for now defaults to first org
DEFAULT_ORG_ID=your-org-uuid-here
